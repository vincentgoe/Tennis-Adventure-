      "texts": [
        {
          "when": {
            "choice_made": "racket"
          },
          "text": "The shed is empty now. Just old nets, ball baskets and dust.",
          "image": "scenes/shed_inside_empty.svg"
        },
        {
          "text": "The lock clicks open and the door creaks. Dust floats in the light. Between old nets and ball baskets, two rackets lean against the wall. One looks almost new. The other has clearly seen better days.",
