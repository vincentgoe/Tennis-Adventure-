          "effects": {
            "set_flags": [
              "knows_groundskeeper"
            ],
            "show_text": "The woman at the desk shakes her head. \"A broken string? I'm sorry, we gave out our last spare racket this morning.\" She thinks for a moment. \"Ask the groundskeeper. He's usually somewhere by the courts. If anyone knows where to find a racket, it's him.\""
          },
          "icon": ":material/help:",
          "hotspot": {
            "x": 96,
            "y": 66,
            "w": 160,
            "h": 80,
            "name": "Front desk"
