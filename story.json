            "not_flags": [
              "registered"
            ]
          },
          "effects": {
            "set_flags": [
              "registered"
            ],
            "show_text": "\"Name?\" The woman at the desk runs her finger down a list. \"There you are.\" She hands you a player badge. \"The group stage starts soon. You can get changed in the locker room.\""
